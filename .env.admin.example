# Run only for database preparation. Never give this file to the bot or worker.
# Use the database owner's actual local PostgreSQL username and connection details.
ADMIN_DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/yuna
# Choose distinct local passwords, then use the same values in the runtime URLs.
BOT_DATABASE_PASSWORD=replace-with-a-random-password
WORKER_DATABASE_PASSWORD=replace-with-another-random-password

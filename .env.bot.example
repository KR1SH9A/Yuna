# Bot process settings; secrets stay in your untracked .env.bot file.
NODE_ENV=development
BOT_DATABASE_URL=postgresql://yuna_bot:replace-with-a-random-password@localhost:5432/yuna
DISCORD_MODE=live
# Paste the token here locally; do not share it in chat.
DISCORD_BOT_TOKEN=
# Discord server ID (Developer Mode -> right-click server -> Copy Server ID).
DISCORD_GUILD_ID=
# fake for the first connection test; match DEEPSEEK_MODEL when enabling live replies.
REPLY_MODEL=fake
# Model selector for the starter moderation policy; match the worker JEV_MODEL.
JEV_MODEL=fake
# Application ID from the Discord Developer Portal, used only by register:commands.
DISCORD_APPLICATION_ID=
# Operator-owned rules/budgets file; see config/README.md for both starter templates.
# YUNA_CONFIG_FILE=config/yuna.json

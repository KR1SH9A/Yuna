# Settings reference. For server installation, copy the three .env.<role>.example files.
# See docs/LOCAL_TEST.md. Never commit local .env files or log configuration objects.
# This combined reference remains in fake Discord mode (no Discord connection).
# Required for both roles: development | test | production. Production rejects fake modes.
NODE_ENV=development

# Bot role: requires its own PostgreSQL URL even when Discord is fake.
# db:prepare provisions roles/tables. Fill role-specific files for the live test.
BOT_DATABASE_URL=postgresql://yuna_bot@localhost:5432/yuna
DISCORD_MODE=fake
# Required only when DISCORD_MODE=live.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Use fake with the fake worker, otherwise match DEEPSEEK_MODEL.
REPLY_MODEL=fake

# Worker role: use restricted worker credentials, never the bot/migration database role.
WORKER_DATABASE_URL=postgresql://yuna_worker@localhost:5432/yuna
# Optional decimal limits: concurrency 1..32 (default 1), request timeout 1..120000 ms (default 30000).
WORKER_CONCURRENCY=1
PROVIDER_REQUEST_TIMEOUT_MS=30000

# DeepSeek direct API: fake | live. Mode is required; a live model must be selected explicitly.
DEEPSEEK_MODE=fake
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Jev through OpenRouter: disabled | fake | live. Defaults to disabled for conversation-first work.
JEV_MODE=disabled
# Required only when JEV_MODE=live. Use a Jev decision-model ID, not the Jev Router chat product.
OPENROUTER_API_KEY=
JEV_MODEL=

# Fake/disabled integrations ignore their unused keys/model settings and return no credentials.
# Copy only the needed sections into your local role-specific environment files.

# Worker process settings; only this process receives provider API keys.
NODE_ENV=development
WORKER_DATABASE_URL=postgresql://yuna_worker:replace-with-another-random-password@localhost:5432/yuna
# Try 2 when conversation_latency queue_wait shows requests waiting behind active calls.
WORKER_CONCURRENCY=1
PROVIDER_REQUEST_TIMEOUT_MS=30000
# fake replies cost nothing. Switch to live and fill the key for real conversations.
DEEPSEEK_MODE=fake
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Use fake for an offline moderation rehearsal; live enables the bounded assessment route.
# A fake assessment stays uncertain and cannot authorize sanctions.
JEV_MODE=disabled
OPENROUTER_API_KEY=
# Choose a Decisions-compatible model; use the same JEV_MODEL in .env.bot.
JEV_MODEL=typesafe/jev-1.14

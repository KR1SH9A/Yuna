NODE_ENV=development
WORKER_DATABASE_URL=postgresql://yuna_worker:replace-with-another-random-password@localhost:5432/yuna
WORKER_CONCURRENCY=1
PROVIDER_REQUEST_TIMEOUT_MS=30000
# fake replies cost nothing. Switch to live and fill the key for real conversations.
DEEPSEEK_MODE=fake
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Jev is staged for a later milestone; no OpenRouter key is needed for this test.
JEV_MODE=disabled
OPENROUTER_API_KEY=
# Pinned OpenRouter decision model; adapter is still deferred.
JEV_MODEL=typesafe/jev-1.14

# Node.js dependencies and local package-manager caches
node_modules/
.npm/
.pnpm-store/

# NestJS / TypeScript build output
dist/
build/
*.tsbuildinfo

# Test coverage and tooling caches
coverage/
.nyc_output/
.cache/
.eslintcache

# Logs and diagnostic reports
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.json

# Local environment values (Discord/provider tokens and database credentials)
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
.direnv/

# Local runtime data: keep PostgreSQL volumes, artifacts and dumps under .local/
/.local/
/tmp/
/temp/

# OS and personal editor files
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~

# Keep lockfiles, migrations, fixtures and shared editor configuration in Git.
considerations.txt
